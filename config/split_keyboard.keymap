#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * ZMK 스플릿 키맵 구조:
         * 왼쪽(Central)    6행 × 8열  = 48키 → 위치 0  ~ 47
         * 오른쪽(Peripheral) 6행 × 11열 = 66키 → 위치 48 ~ 113
         * 반드시 왼쪽 전체를 먼저 나열한 뒤 오른쪽을 나열해야 합니다.
         */
        default_layer {
            bindings = <
/* ===== 왼쪽 (Central) 6행 × 8열 ===== */
/* Row 0 */ &kp ESC   &kp F1   &kp F2   &kp F3   &kp F4    &kp F5   &kp F6   &none
/* Row 1 */ &kp GRAVE &kp N1   &kp N2   &kp N3   &kp N4    &kp N5   &kp N6   &kp N7
/* Row 2 */ &kp TAB   &kp Q    &kp W    &kp E    &kp R     &kp T    &kp Y    &none
/* Row 3 */ &kp CLCK  &kp A    &kp S    &kp D    &kp F     &kp G    &kp H    &none
/* Row 4 */ &kp LSHFT &kp Z    &kp X    &kp C    &kp V     &kp B    &none    &none
/* Row 5 */ &kp LCTRL &kp LGUI &kp LALT &none    &kp SPACE &none    &none    &none
/* ===== 오른쪽 (Peripheral) 6행 × 11열 ===== */
/* Row 0 */ &none     &kp F7  &kp F8  &none    &kp F9    &kp F10   &kp F11  &kp F12  &kp PSCRN &kp SLCK  &kp PAUSE_BREAK
/* Row 1 */ &kp N7    &kp N8  &kp N9  &kp N0   &kp MINUS &kp EQUAL &none    &kp BSPC &kp INS   &kp HOME  &kp PG_UP
/* Row 2 */ &kp Y     &kp U   &kp I   &kp O    &kp P     &kp LBKT  &kp RBKT &kp BSLH &kp DEL   &kp END   &kp PG_DN
/* Row 3 */ &kp H     &kp J   &kp K   &kp L    &kp SEMI  &kp SQT   &none    &kp ENTER &none    &none     &none
/* Row 4 */ &kp B     &kp N   &kp M   &kp COMMA &kp DOT  &kp FSLH  &none    &kp RSHFT &none    &kp UP    &none
/* Row 5 */ &none     &none   &kp SPACE &none   &kp RALT &mo 1     &kp K_APP &kp RCTRL &kp LEFT &kp DOWN  &kp RIGHT
            >;
        };

        fn_layer {
            bindings = <
/* ===== 왼쪽 (Central) 6행 × 8열 ===== */
/* Row 0 */ &none  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &none  &none  &none
/* Row 1 */ &trans &trans       &trans       &trans       &trans     &trans &trans &trans
/* Row 2 */ &trans &trans       &trans       &trans       &trans     &trans &trans &none
/* Row 3 */ &trans &trans       &trans       &trans       &trans     &trans &trans &none
/* Row 4 */ &trans &trans       &trans       &trans       &trans     &trans &none  &none
/* Row 5 */ &trans &trans       &trans       &none        &trans     &none  &none  &none
/* ===== 오른쪽 (Peripheral) 6행 × 11열 ===== */
/* Row 0 */ &none  &trans &trans &none  &trans &trans &trans  &trans    &trans    &trans    &trans
/* Row 1 */ &trans &trans &trans &trans &trans &trans &none   &kp DEL   &trans    &trans    &trans
/* Row 2 */ &trans &trans &trans &trans &trans &trans &trans  &trans    &trans    &trans    &trans
/* Row 3 */ &trans &trans &trans &trans &trans &trans &none   &trans    &none     &none     &none
/* Row 4 */ &trans &trans &trans &trans &trans &trans &none   &trans    &none     &trans    &none
/* Row 5 */ &none  &none  &trans &none  &trans &trans &trans  &trans    &kp PG_UP &kp PG_DN &kp END
            >;
        };
    };
};