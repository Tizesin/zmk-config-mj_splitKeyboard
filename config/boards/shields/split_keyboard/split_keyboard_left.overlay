#include <dt-bindings/zmk/matrix_transform.h>

// ============================================================
// 왼쪽 핀 매핑 (확정):
//   Row 0 = P0.31 / Row 1 = P0.29 / Row 2 = P0.02
//   Row 3 = P1.15 / Row 4 = P1.13 / Row 5 = P1.11
//   Col 0 = P0.10 / Col 1 = P0.09 / Col 2 = P1.07
//   Col 3 = P1.02 / Col 4 = P1.01 / Col 5 = P1.06
//   Col 6 = P1.04 / Col 7 = P1.00
//   UART TX = P0.06 (고정) / UART RX = P0.08 (고정)
// ============================================================

&uart0 {
    status = "okay";
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <11>;
        rows = <12>;
        map = <
            // ===== 왼쪽 (Central) =====
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(5,7)

            // ===== 오른쪽 (Peripheral) =====
            RC(6,0)  RC(6,1)  RC(6,2)  RC(6,3)  RC(6,4)  RC(6,5)  RC(6,6)  RC(6,7)  RC(6,8)  RC(6,9)  RC(6,10)
            RC(7,0)  RC(7,1)  RC(7,2)  RC(7,3)  RC(7,4)  RC(7,5)  RC(7,6)  RC(7,7)  RC(7,8)  RC(7,9)  RC(7,10)
            RC(8,0)  RC(8,1)  RC(8,2)  RC(8,3)  RC(8,4)  RC(8,5)  RC(8,6)  RC(8,7)  RC(8,8)  RC(8,9)  RC(8,10)
            RC(9,0)  RC(9,1)  RC(9,2)  RC(9,3)  RC(9,4)  RC(9,5)  RC(9,6)  RC(9,7)  RC(9,8)  RC(9,9)  RC(9,10)
            RC(10,0) RC(10,1) RC(10,2) RC(10,3) RC(10,4) RC(10,5) RC(10,6) RC(10,7) RC(10,8) RC(10,9) RC(10,10)
            RC(11,0) RC(11,1) RC(11,2) RC(11,3) RC(11,4) RC(11,5) RC(11,6) RC(11,7) RC(11,8) RC(11,9) RC(11,10)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 0 = P0.31
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 1 = P0.29
            , <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 2 = P0.02
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 3 = P1.15
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 4 = P1.13
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // Row 5 = P1.11

        col-gpios
            = <&gpio0 10 GPIO_ACTIVE_HIGH>  // Col 0 = P0.10
            , <&gpio0  9 GPIO_ACTIVE_HIGH>  // Col 1 = P0.09
            , <&gpio1  7 GPIO_ACTIVE_HIGH>  // Col 2 = P1.07
            , <&gpio1  2 GPIO_ACTIVE_HIGH>  // Col 3 = P1.02
            , <&gpio1  1 GPIO_ACTIVE_HIGH>  // Col 4 = P1.01
            , <&gpio1  6 GPIO_ACTIVE_HIGH>  // Col 5 = P1.06
            , <&gpio1  4 GPIO_ACTIVE_HIGH>  // Col 6 = P1.04
            , <&gpio1  0 GPIO_ACTIVE_HIGH>; // Col 7 = P1.00
    };
};
