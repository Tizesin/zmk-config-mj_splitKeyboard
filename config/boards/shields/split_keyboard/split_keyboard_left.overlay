#include <dt-bindings/zmk/matrix_transform.h>

// ============================================================
// 왼쪽 핀 매핑 (확정):
//   Row 0 = P0.31 / Row 1 = P0.29 / Row 2 = P0.02
//   Row 3 = P1.15 / Row 4 = P1.13 / Row 5 = P1.11
//   Col 0 = P0.10 / Col 1 = P0.09 / Col 2 = P1.07
//   Col 3 = P1.02 / Col 4 = P1.01 / Col 5 = P1.06
//   Col 6 = P1.04 / Col 7 = P1.00
//   UART TX = P0.06 (고정) / UART RX = P0.08 (고정)
// ============================================================

&uart0 {
    status = "okay";
    current-speed = <115200>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,split-uart = &uart0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 0 = P0.31
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 1 = P0.29
            , <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 2 = P0.02
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 3 = P1.15
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 4 = P1.13
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // Row 5 = P1.11

        col-gpios
            = <&gpio0 10 GPIO_ACTIVE_HIGH>  // Col 0 = P0.10
            , <&gpio0  9 GPIO_ACTIVE_HIGH>  // Col 1 = P0.09
            , <&gpio1  7 GPIO_ACTIVE_HIGH>  // Col 2 = P1.07
            , <&gpio1  2 GPIO_ACTIVE_HIGH>  // Col 3 = P1.02
            , <&gpio1  1 GPIO_ACTIVE_HIGH>  // Col 4 = P1.01
            , <&gpio1  6 GPIO_ACTIVE_HIGH>  // Col 5 = P1.06
            , <&gpio1  4 GPIO_ACTIVE_HIGH>  // Col 6 = P1.04
            , <&gpio1  0 GPIO_ACTIVE_HIGH>; // Col 7 = P1.00
    };
};
