#include <dt-bindings/zmk/matrix_transform.h>

// ============================================================
// 오른쪽 핀 매핑 (확정):
//   Row 6  = P0.20 / Row 7  = P0.22 / Row 8  = P0.24
//   Row 9  = P1.00 / Row 10 = P1.04 / Row 11 = P1.06
//   Col 8  = P0.31 / Col 9  = P0.29 / Col 10 = P0.02
//   Col 11 = P1.15 / Col 12 = P1.13 / Col 13 = P1.11
//   Col 14 = P0.10 / Col 15 = P0.09 / Col 16 = P1.07
//   Col 17 = P1.02 / Col 18 = P1.01
//   UART TX = P0.06 (고정) / UART RX = P0.08 (고정)
// ============================================================

&uart0 {
    status = "okay";
    current-speed = <115200>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,split-uart = &uart0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 6  = P0.20
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 7  = P0.22
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 8  = P0.24
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 9  = P1.00
            , <&gpio1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 10 = P1.04
            , <&gpio1  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // Row 11 = P1.06

        col-gpios
            = <&gpio0 31 GPIO_ACTIVE_HIGH>  // Col 8  = P0.31
            , <&gpio0 29 GPIO_ACTIVE_HIGH>  // Col 9  = P0.29
            , <&gpio0  2 GPIO_ACTIVE_HIGH>  // Col 10 = P0.02
            , <&gpio1 15 GPIO_ACTIVE_HIGH>  // Col 11 = P1.15
            , <&gpio1 13 GPIO_ACTIVE_HIGH>  // Col 12 = P1.13
            , <&gpio1 11 GPIO_ACTIVE_HIGH>  // Col 13 = P1.11
            , <&gpio0 10 GPIO_ACTIVE_HIGH>  // Col 14 = P0.10
            , <&gpio0  9 GPIO_ACTIVE_HIGH>  // Col 15 = P0.09
            , <&gpio1  7 GPIO_ACTIVE_HIGH>  // Col 16 = P1.07
            , <&gpio1  2 GPIO_ACTIVE_HIGH>  // Col 17 = P1.02
            , <&gpio1  1 GPIO_ACTIVE_HIGH>; // Col 18 = P1.01
    };
};
