#include <dt-bindings/zmk/matrix_transform.h>

// ============================================================
// 오른쪽 핀 매핑 (확정):
//   Row 6  = P0.20 / Row 7  = P0.22 / Row 8  = P0.24
//   Row 9  = P1.00 / Row 10 = P1.04 / Row 11 = P1.06
//   Col 8  = P0.31 / Col 9  = P0.29 / Col 10 = P0.02
//   Col 11 = P1.15 / Col 12 = P1.13 / Col 13 = P1.11
//   Col 14 = P0.10 / Col 15 = P0.09 / Col 16 = P1.07
//   Col 17 = P1.02 / Col 18 = P1.01
//   UART TX = P0.06 (고정) / UART RX = P0.08 (고정)
// ============================================================

&uart0 {
    status = "okay";
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform 0 {
        compatible = "zmk,matrix-transform";
        columns = <19>;
        rows = <6>;
        map = <
            // ===== 왼쪽 (Central) =====
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(5,7)

            // ===== 오른쪽 (Peripheral) =====
            RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17) RC(0,18)
            RC(1,8)  RC(1,9)  RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15) RC(1,16) RC(1,17) RC(1,18)
            RC(2,8)  RC(2,9)  RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15) RC(2,16) RC(2,17) RC(2,18)
            RC(3,8)  RC(3,9)  RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15) RC(3,16) RC(3,17) RC(3,18)
            RC(4,8)  RC(4,9)  RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15) RC(4,16) RC(4,17) RC(4,18)
            RC(5,8)  RC(5,9)  RC(5,10) RC(5,11) RC(5,12) RC(5,13) RC(5,14) RC(5,15) RC(5,16) RC(5,17) RC(5,18)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 6  = P0.20
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 7  = P0.22
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 8  = P0.24
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 9  = P1.00
            , <&gpio1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 10 = P1.04
            , <&gpio1  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // Row 11 = P1.06

        col-gpios
            = <&gpio0 31 GPIO_ACTIVE_HIGH>  // Col 8  = P0.31
            , <&gpio0 29 GPIO_ACTIVE_HIGH>  // Col 9  = P0.29
            , <&gpio0  2 GPIO_ACTIVE_HIGH>  // Col 10 = P0.02
            , <&gpio1 15 GPIO_ACTIVE_HIGH>  // Col 11 = P1.15
            , <&gpio1 13 GPIO_ACTIVE_HIGH>  // Col 12 = P1.13
            , <&gpio1 11 GPIO_ACTIVE_HIGH>  // Col 13 = P1.11
            , <&gpio0 10 GPIO_ACTIVE_HIGH>  // Col 14 = P0.10
            , <&gpio0  9 GPIO_ACTIVE_HIGH>  // Col 15 = P0.09
            , <&gpio1  7 GPIO_ACTIVE_HIGH>  // Col 16 = P1.07
            , <&gpio1  2 GPIO_ACTIVE_HIGH>  // Col 17 = P1.02
            , <&gpio1  1 GPIO_ACTIVE_HIGH>; // Col 18 = P1.01
    };
};
