#include <dt-bindings/zmk/matrix_transform.h>

// ============================================================
// nice!nano v2 핀 매핑 참고:
//   Arduino D# -> GPIO 변환표
//   D0  = P0.08  D1  = P0.06  D2  = P0.17  D3  = P0.20
//   D4  = P0.22  D5  = P0.24  D6  = P1.00  D7  = P0.11
//   D8  = P1.04  D9  = P1.06  D10 = P0.09  D14 = P1.11
//   D15 = P1.13  D16 = P0.10  D18 = P1.15  D19 = P0.02
//   D20 = P0.29  D21 = P0.31
// UART TX = D1 = P0.06 (고정, 변경 불가)
// UART RX = D0 = P0.08 (고정, 변경 불가)
// ============================================================

&uart0 {
    status = "okay";
};

/ {
    wired_split: wired_split {
        compatible = "zmk,wired-split";
        device = <&uart0>;
    };

    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        // [수정 필요 여부 확인] 회로도에서 Row 핀을 연결한 D번호와 아래 매핑이 일치하는지 확인하세요.
        // 순서: 회로도 위에서부터 Row 6, Row 7, ... 순서대로 나열해야 합니다.
        row-gpios
            = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // [수정 필요] Row 6  = D3  = P0.20  → 회로도와 다르면 D번호 교체
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // [수정 필요] Row 7  = D2  = P0.17  → 회로도와 다르면 D번호 교체
            , <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // [수정 필요] Row 8  = D21 = P0.31  → 회로도와 다르면 D번호 교체
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // [수정 필요] Row 9  = D20 = P0.29  → 회로도와 다르면 D번호 교체
            , <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // [수정 필요] Row 10 = D19 = P0.02  → 회로도와 다르면 D번호 교체
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // [수정 필요] Row 11 = D18 = P1.15  → 회로도와 다르면 D번호 교체

        // [수정 필요 여부 확인] 회로도에서 Col 핀을 연결한 D번호와 아래 매핑이 일치하는지 확인하세요.
        // 순서: 회로도 왼쪽에서부터 Col 8, Col 9, ... 순서대로 나열해야 합니다.
        // ※ Col 18은 회로도에서 정확히 읽지 못했습니다. 특히 확인이 필요합니다.
        col-gpios
            = <&gpio1 13 GPIO_ACTIVE_HIGH>  // [수정 필요] Col 8  = D15 = P1.13  → 회로도와 다르면 D번호 교체
            , <&gpio1 11 GPIO_ACTIVE_HIGH>  // [수정 필요] Col 9  = D14 = P1.11  → 회로도와 다르면 D번호 교체
            , <&gpio0 10 GPIO_ACTIVE_HIGH>  // [수정 필요] Col 10 = D16 = P0.10  → 회로도와 다르면 D번호 교체
            , <&gpio0  9 GPIO_ACTIVE_HIGH>  // [수정 필요] Col 11 = D10 = P0.09  → 회로도와 다르면 D번호 교체
            , <&gpio1  6 GPIO_ACTIVE_HIGH>  // [수정 필요] Col 12 = D9  = P1.06  → 회로도와 다르면 D번호 교체
            , <&gpio1  4 GPIO_ACTIVE_HIGH>  // [수정 필요] Col 13 = D8  = P1.04  → 회로도와 다르면 D번호 교체
            , <&gpio0 11 GPIO_ACTIVE_HIGH>  // [수정 필요] Col 14 = D7  = P0.11  → 회로도와 다르면 D번호 교체
            , <&gpio1  0 GPIO_ACTIVE_HIGH>  // [수정 필요] Col 15 = D6  = P1.00  → 회로도와 다르면 D번호 교체
            , <&gpio0 22 GPIO_ACTIVE_HIGH>  // [수정 필요] Col 16 = D4  = P0.22  → 회로도와 다르면 D번호 교체
            , <&gpio0 24 GPIO_ACTIVE_HIGH>  // [수정 필요] Col 17 = D5  = P0.24  → 회로도와 다르면 D번호 교체
            , <&gpio0 17 GPIO_ACTIVE_HIGH>; // [★확인 필수★] Col 18 = D2? = P0.17  → 회로도 이미지에서 정확히 판독 불가, 반드시 확인
    };
};
